---
import Brand from './Brand.astro';
import SiteSearch from './SiteSearch.astro';
import '../styles/site.css';
const { lang = 'en', translationPath = lang === 'en' ? '/zh-cn/' : '/en/' } = Astro.props;
const zh = lang === 'zh-cn';
const links = [
  ['product', zh ? '产品' : 'Product'],
  ['ai-engineering', zh ? '学习 AI 开发' : 'Learn AI Development'],
  ['steerline', zh ? '学习 SteerLine' : 'Learn SteerLine'],
  ['docs', zh ? '文档' : 'Docs'],
];
---
<div class="site-nav-shell">
  <Brand lang={lang} />
  <nav class="site-nav" aria-label={zh ? '主导航' : 'Main navigation'}>{links.map(([path, label]) => <a href={`/${lang}/${path}/`} aria-current={Astro.url.pathname.startsWith(`/${lang}/${path}/`) || (path === 'ai-engineering' && Astro.url.pathname.startsWith(`/${lang}/articles/`)) ? 'page' : undefined}>{label}</a>)}</nav>
  <div class="site-nav-end"><SiteSearch lang={lang} />{translationPath ? <a class="site-language" href={translationPath} lang={zh ? 'en' : 'zh-CN'}>{zh ? 'EN' : '中文'}</a> : <span class="site-language" title={zh ? '英文版尚未翻译' : 'Chinese translation unavailable'}>{zh ? 'EN 暂缺' : '中文暂缺'}</span>}<a class="site-github" href="https://github.com/erranliu/SteerLine" aria-label="GitHub"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.09.67-3.74-1.31-3.74-1.31-.51-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.7 2.6 1.21 3.24.93.1-.72.39-1.21.7-1.49-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.44-2.2 1.15-2.98-.12-.28-.5-1.41.11-2.94 0 0 .94-.3 3.05 1.14a10.6 10.6 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.12 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.21-5.08 5.48.4.35.75 1.02.75 2.06v3.07c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg></a></div>
</div>
