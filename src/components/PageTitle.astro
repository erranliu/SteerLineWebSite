---
const { entry, locale } = Astro.locals.starlightRoute;
const stale = entry.data.translationStatus === 'needs-sync';
---
{stale && <aside class="translation-notice" role="note">{locale === 'zh-cn' ? '此版本可能落后于原文，正在等待同步。' : 'This translation may be out of date and is awaiting an update.'}</aside>}
<h1 id="_top">{entry.data.title}</h1>
<style>
  h1 { margin-top: 1rem; font-size: var(--sl-text-h1); line-height: var(--sl-line-height-headings); font-weight: 600; color: var(--sl-color-white); }
  .translation-notice { border-left: 3px solid #bb8a3c; padding: .75rem 1rem; background: #f7ead3; color: #62481d; font-size: .9rem; }
</style>
