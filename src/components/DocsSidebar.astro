---
import { getCollection } from 'astro:content';
import { learningGroups } from '../data/learning';
const { entry, locale } = Astro.locals.starlightRoute;
const zh = locale === 'zh-cn';
const lang = zh ? 'zh-cn' : 'en';
const section = entry.data.contentId?.split('/')[0] ?? 'docs';
const isColumn = section === 'articles';
const isLearning = section === 'ai-engineering' || isColumn;
const homeSection = isLearning ? 'ai-engineering' : section;
const allDocs = await getCollection('docs');
const docs = allDocs.filter((doc) => doc.id.startsWith(`${lang}/`) && doc.data.contentId.startsWith(`${section}/`));
const label = isLearning ? (zh ? '学习 AI 开发' : 'Learn AI Development') : section === 'steerline' ? (zh ? '学习 SteerLine' : 'Learn SteerLine') : section === 'docs' ? (zh ? '文档' : 'Documentation') : entry.data.title;
const groups = isLearning ? learningGroups.map((group) => ({ title: group.title[zh ? 0 : 1], sequential: group.sequential, articles: group.items.map((slug) => allDocs.find((doc) => doc.data.contentId === `${group.section}/${slug}` && doc.id.startsWith(`${lang}/`)) ?? (!group.sequential ? allDocs.find((doc) => doc.data.contentId === `${group.section}/${slug}` && doc.id.startsWith('zh-cn/')) : undefined)).filter((doc) => !!doc) })) : [{ title: zh ? '目录' : 'Contents', sequential: true, articles: docs.filter((doc) => !doc.data.contentId.endsWith('/index')) }];
---
<div class="course-sidebar">
  <p class="course-sidebar-kicker">{isLearning ? 'LEARNING / AI' : 'STEERLINE / GUIDES'}</p>
  <a class="course-sidebar-home" href={`/${lang}/${homeSection}/`}>{label}<span aria-hidden="true">↗</span></a>
  {isLearning && <a class="course-overview" href={`/${lang}/ai-engineering/`}>{zh ? '← 返回学习首页' : '← Learning overview'}</a>}
  {groups.filter((group) => group.articles.length > 0).map((group) => {
    const List = group.sequential ? 'ol' : 'ul';
    return <details open={group.articles.some((doc) => doc.data.contentId === entry.data.contentId) || (isColumn && !group.sequential) || !isLearning}><summary>{group.title}</summary><List>{group.articles.map((doc, index) => <li><a href={`/${doc.id.replace(/\/index$/, '')}/`} aria-current={entry.id === doc.id ? 'page' : undefined}>{group.sequential && <span class="course-item-number">{String(index + 1).padStart(2, '0')}</span>}<span>{doc.data.title}{!zh && doc.id.startsWith('zh-cn/') && ' (中文)'}</span></a></li>)}</List></details>;
  })}
</div>
