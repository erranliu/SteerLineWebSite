---
const { lang = 'en' } = Astro.props;
const zh = lang === 'zh-cn';
---
<site-search-dialog data-lang={lang}>
  <button class="site-search-trigger" aria-label={zh ? '搜索网站' : 'Search the site'} aria-haspopup="dialog"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>{zh ? '搜索' : 'Search'}</span><kbd>/</kbd></button>
  <dialog class="site-search-dialog" aria-label={zh ? '站内搜索' : 'Site search'}>
    <form method="dialog"><label><span class="search-label">{zh ? '搜索教程与文档' : 'Search guides and documentation'}</span><input type="search" placeholder={zh ? '输入关键词…' : 'Type a keyword…'} autocomplete="off" /></label><button class="search-close" aria-label={zh ? '关闭搜索' : 'Close search'}>✕</button></form>
    <p class="search-status" role="status">{zh ? '输入关键词，查找学习内容。' : 'Enter a keyword to find learning resources.'}</p>
    <ul class="search-results"></ul>
  </dialog>
</site-search-dialog>
<script>
  class SiteSearchDialog extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog')!;
      const input = this.querySelector('input')!;
      const status = this.querySelector<HTMLElement>('.search-status')!;
      const results = this.querySelector('.search-results')!;
      const zh = this.dataset.lang === 'zh-cn';
      let request = 0;
      let timer: ReturnType<typeof setTimeout>;
      const open = () => { dialog.showModal(); input.focus(); };
      this.querySelector('.site-search-trigger')!.addEventListener('click', open);
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && !dialog.open && !(event.target instanceof HTMLInputElement) && !(event.target instanceof HTMLTextAreaElement) && !(event.target instanceof HTMLElement && event.target.isContentEditable)) { event.preventDefault(); open(); }
      });
      input.addEventListener('input', () => {
        clearTimeout(timer);
        const current = ++request;
        results.replaceChildren();
        const query = input.value.trim();
        if (!query) { status.textContent = zh ? '输入关键词，查找学习内容。' : 'Enter a keyword to find learning resources.'; return; }
        status.textContent = zh ? '正在搜索…' : 'Searching…';
        timer = setTimeout(async () => {
          try {
            const url = '/pagefind/pagefind.js';
            const pagefind = await import(/* @vite-ignore */ url);
            const search = await pagefind.search(query);
            const entries = await Promise.all(search.results.slice(0, 12).map((result: { data: () => Promise<{ url: string; meta: { title: string }; excerpt: string }> }) => result.data()));
            if (current !== request) return;
            status.textContent = entries.length ? (zh ? `找到 ${search.results.length} 条结果` : `${search.results.length} results`) : (zh ? '没有找到结果，试试其他关键词。' : 'No results. Try another keyword.');
            for (const entry of entries) {
              const li = document.createElement('li');
              const link = document.createElement('a'); link.href = entry.url;
              const title = document.createElement('strong'); title.textContent = entry.meta.title;
              const excerpt = document.createElement('p');
              const parsed = new DOMParser().parseFromString(entry.excerpt, 'text/html');
              excerpt.textContent = parsed.body.textContent;
              link.append(title, excerpt); li.append(link); results.append(li);
            }
          } catch {
            if (current === request) status.textContent = zh ? '搜索索引尚未就绪，请在构建后的预览中使用搜索。' : 'The search index is not ready. Search is available in the built preview.';
          }
        }, 180);
      });
    }
  }
  if (!customElements.get('site-search-dialog')) customElements.define('site-search-dialog', SiteSearchDialog);
</script>
