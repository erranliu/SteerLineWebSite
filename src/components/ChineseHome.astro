---
const github = 'https://github.com/erranliu/SteerLine';
const flow = [
  { title: '明确工作依据', body: '用 Roadmap、Spec 和 Plan 明确目标、任务边界与通过条件。' },
  { title: '把要求带入执行', body: '向 Agent 注入当前任务需要的规范与提示，通过流程脚本落实检查。' },
  { title: '按结果推进', body: '核验测试与交付事实，满足依赖后推进后续任务，让结果回到规划。' },
];
const changes = [
  ['规划', '向各个 Agent 分配任务、补充背景', '与主 Agent 澄清目标，组织规划与任务依据'],
  ['协作', '跟踪进度，协调任务和上下文交接', '维护任务依赖，按流程组织多个 Agent 执行'],
  ['验收', '汇总 Agent 反馈，逐项检查结果', '按通过条件核验测试与交付事实'],
  ['人的投入', '产品决策，以及大量日常协调', '产品方向、关键取舍与必要验收'],
];
---

<section class="hero workshop-hero wrap" aria-labelledby="home-title">
  <div>
    <p class="eyebrow"><span class="signal"></span>AI WORKSHOP · 面向项目的 AI 开发系统</p>
    <h1 id="home-title" data-pagefind-meta="title">你把握产品方向，<br />SteerLine 组织开发。</h1>
    <p class="lead">SteerLine 定义 AI Workshop：以多 Agent 编排为基础，将开发方法与工具融入项目流程。</p>
    <p class="hero-detail">主 Agent 与你讨论需求、管理流程，多个执行 Agent 承担实现、测试与修复，让项目持续推进。</p>
    <div class="actions">
      <a class="button dark" href="#workflow">看看开发方式的变化 <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={github}>查看 GitHub <span aria-hidden="true">↗</span></a>
    </div>
    <p class="release"><span class="signal"></span>开源 · 尚未发布 · 目标工作方式</p>
  </div>

  <aside class="workshop-map" aria-label="AI Workshop 目标工作方式：用户与主 Agent 交互，主 Agent 协调多个执行 Agent，由项目流程贯穿规划、执行与验收">
    <div class="workshop-caption"><span>AI WORKSHOP</span><span>目标工作方式</span></div>
    <div class="workshop-person"><span class="role-label">你</span><strong>目标 · 取舍 · 关键决策</strong></div>
    <div class="workshop-connector" aria-hidden="true">↕</div>
    <div class="workshop-lead"><span class="role-label">STEERLINE 主 AGENT</span><strong>理解需求，组织项目</strong><p>规划 · 协调 · 监督执行</p></div>
    <div class="workshop-connector" aria-hidden="true">↓</div>
    <div class="workshop-agents" aria-label="多个执行 Agent">
      <div><span>执行 AGENT</span><strong>实现</strong></div>
      <div><span>执行 AGENT</span><strong>测试</strong></div>
      <div><span>执行 AGENT</span><strong>修复</strong></div>
    </div>
    <div class="workshop-foundation"><span class="signal"></span><span>项目流程贯穿规划、执行与验收</span></div>
    <p class="workshop-feedback"><span aria-hidden="true">↶</span> 交付结果回到规划，继续推进</p>
  </aside>
</section>

<section class="section workshop-reason" aria-labelledby="reason-title"><div class="wrap">
  <div class="section-heading">
    <p class="eyebrow">01 / 为什么注入流程</p>
    <div>
      <h2 id="reason-title">Agent 越多，<br />项目越需要组织。</h2>
      <p>多个 Agent 能同时写代码，任务拆分、进度协调和结果检查仍会消耗人的注意力。执行能力增长，也可能带来更多管理工作。</p>
      <p class="reason-point">SteerLine 通过主 Agent 承接协调，通过流程约束执行，让人聚焦目标与关键决策。</p>
    </div>
  </div>
  <ol class="flow-steps">
    {flow.map((step, i) => <li><span class="number">0{i + 1}</span><h3>{step.title}</h3><p>{step.body}</p></li>)}
  </ol>
</div></section>

<section class="section wrap workshop-changes" id="workflow" aria-labelledby="workflow-title">
  <div class="section-heading">
    <p class="eyebrow">02 / 开发方式的变化</p>
    <div><h2 id="workflow-title">从逐个推动 Agent，<br />到围绕目标管理项目。</h2><p>AI Agent 逐步执行任务；AI Workshop 组织多个 Agent，让任务衔接成持续的项目开发。</p></div>
  </div>
  <table class="workflow-table">
    <caption class="visually-hidden">人直接组织 Agent 与 SteerLine 目标开发流程的对比</caption>
    <thead><tr><th scope="col">开发环节</th><th scope="col">人直接组织 Agent</th><th scope="col">SteerLine 目标流程</th></tr></thead>
    <tbody>{changes.map(([stage, before, after]) => <tr><th scope="row">{stage}</th><td>{before}</td><td>{after}</td></tr>)}</tbody>
  </table>
  <a class="text-link section-link" href="/zh-cn/product/#workflow">进一步了解开发流程 <span aria-hidden="true">→</span></a>
</section>

<section class="workshop-status" aria-labelledby="status-title"><div class="wrap status-layout">
  <div><p class="eyebrow">当前阶段 · 尚未发布</p><h2 id="status-title">逐步构建 AI Workshop。</h2><p>已有任务依赖、执行与交付核验等基础。面向用户的主 Agent、完整项目周期管理与有限自主推进仍在建设中。</p></div>
  <div class="status-links"><a class="button light" href="/zh-cn/product/#current-stage">查看当前能力 <span aria-hidden="true">↗</span></a><a class="text-link" href="/zh-cn/updates/">项目更新 <span aria-hidden="true">→</span></a></div>
</div></section>

<nav class="wrap workshop-explore" aria-label="继续了解">
  <span>继续了解</span>
  <a class="text-link" href="/zh-cn/ai-engineering/">学习 AI 开发 <span aria-hidden="true">↗</span></a>
  <a class="text-link" href="/zh-cn/steerline/">学习 SteerLine <span aria-hidden="true">↗</span></a>
</nav>

<style>
  .workshop-hero { gap: 56px; padding-top: 76px; padding-bottom: 88px; }
  .workshop-hero h1 { font-size: clamp(34px, 3.5vw, 50px); line-height: 1.35; }
  .workshop-hero .lead { color: #385b46; margin-bottom: 12px; }
  .hero-detail { font-size: 14px; line-height: 1.9; color: #66756b; max-width: 510px; margin-top: 0; }
  .workshop-map { padding: 26px; background: #edf3eb; border: 1px solid #d4dfd2; box-shadow: 12px 12px 0 #eef1e9; }
  .workshop-caption { display: flex; justify-content: space-between; gap: 16px; color: #617c68; font-size: 10px; letter-spacing: .08em; margin-bottom: 24px; }
  .workshop-person { text-align: center; padding: 15px; }
  .role-label { display: block; color: #617c68; font-size: 10px; letter-spacing: .08em; margin-bottom: 8px; }
  .workshop-map strong { font-size: 16px; font-weight: 600; line-height: 1.6; }
  .workshop-connector { text-align: center; color: #769580; padding: 7px; }
  .workshop-lead { background: #244e3b; color: white; text-align: center; padding: 23px 15px; }
  .workshop-lead .role-label { color: #c4dbca; }
  .workshop-lead strong { font-size: 21px; }
  .workshop-lead p { font-size: 12px; color: #d1e0d2; margin: 9px 0 0; }
  .workshop-agents { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .workshop-agents > div { text-align: center; background: #f7faf4; border: 1px solid #c9d8c7; padding: 16px 6px; }
  .workshop-agents span { display: block; font-size: 9px; color: #617c68; margin-bottom: 8px; }
  .workshop-foundation { display: flex; gap: 12px; justify-content: center; align-items: center; font-size: 12px; line-height: 1.8; margin-top: 22px; }
  .workshop-feedback { border-top: 1px solid #cfdcc9; text-align: center; padding-top: 15px; margin-bottom: 0; font-size: 11px; line-height: 1.8; color: #617c68; }
  .workshop-feedback span { margin-right: 6px; }
  .workshop-reason { background: #eef2eb; }
  .workshop-reason .reason-point { color: #244e3b; font-weight: 600; }
  .flow-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 38px; list-style: none; padding: 0; margin: 38px 0 0; }
  .flow-steps li { border-top: 1px solid #cbd8ca; padding-top: 20px; }
  .flow-steps h3 { font-size: 19px; font-weight: 600; margin: 18px 0 10px; }
  .flow-steps p { font-size: 14px; line-height: 1.9; color: #65796b; margin-bottom: 0; }
  .workshop-changes { scroll-margin-top: 30px; }
  .workflow-table { width: 100%; border-collapse: collapse; margin-top: 38px; text-align: left; font-size: 14px; line-height: 1.9; }
  .workflow-table th, .workflow-table td { padding: 22px 24px; border-bottom: 1px solid #d4dfd2; }
  .workflow-table thead th { font-size: 12px; background: #edf2e9; font-weight: 600; }
  .workflow-table thead th:first-child { width: 16%; }
  .workflow-table thead th:not(:first-child) { width: 42%; }
  .workflow-table tbody th { font-weight: 600; }
  .workflow-table td { color: #65796b; }
  .workflow-table th:last-child, .workflow-table td:last-child { color: #244e3b; background: #e9f0e5; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .workshop-status { background: #244c3a; color: #fff; padding: 54px 0; }
  .status-layout { display: grid; grid-template-columns: 1fr auto; gap: 60px; align-items: center; }
  .workshop-status .eyebrow { color: #b2d0b9; margin-top: 0; }
  .workshop-status h2 { font-size: 30px; line-height: 1.4; margin: 14px 0; }
  .workshop-status p:not(.eyebrow) { max-width: 700px; color: #d1e0d2; font-size: 14px; line-height: 1.9; margin-bottom: 0; }
  .status-links { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .workshop-explore { display: flex; align-items: center; flex-wrap: wrap; gap: 20px 36px; padding-top: 30px; padding-bottom: 30px; }
  .workshop-explore > span { color: #66756b; font-size: 12px; margin-right: auto; }
  @media (max-width: 1080px) {
    .workshop-hero { gap: 32px; }
    .workshop-hero h1 { font-size: clamp(32px, 3.5vw, 44px); }
    .workshop-map { padding: 20px; }
  }
  @media (max-width: 760px) {
    .workshop-hero { gap: 36px; padding-top: 42px; padding-bottom: 60px; }
    .workshop-hero h1 { font-size: clamp(28px, 7.2vw, 46px); }
    .workshop-hero .eyebrow { font-size: 10px; letter-spacing: .04em; }
    .workshop-map { box-shadow: 8px 8px 0 #eef1e9; }
    .workshop-caption { margin-bottom: 14px; }
    .workshop-person { padding: 8px; }
    .workshop-agents { gap: 8px; }
    .flow-steps { grid-template-columns: 1fr; gap: 24px; margin-top: 28px; }
    .flow-steps h3 { margin-top: 12px; }
    .workflow-table { font-size: 12px; margin-top: 24px; }
    .workflow-table th, .workflow-table td { padding: 16px 10px; vertical-align: top; }
    .workflow-table thead th { font-size: 11px; }
    .workflow-table thead th:first-child { width: 18%; }
    .workflow-table thead th:not(:first-child) { width: 41%; }
    .workshop-status { padding: 42px 0; }
    .status-layout { grid-template-columns: 1fr; gap: 26px; }
    .workshop-status h2 { font-size: 26px; }
    .status-links { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 24px; }
    .workshop-explore { gap: 18px 24px; }
    .workshop-explore > span { width: 100%; }
  }
</style>
