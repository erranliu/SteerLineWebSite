---
import '../../styles/home.css';
import '../../styles/mobile.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'zh-cn' } }]; }
const zh = Astro.params.lang === 'zh-cn';
const lang = zh ? 'zh-cn' : 'en';
const t = zh ? {
  nav: ['产品', '学习 AI 开发', '学习 SteerLine', '文档'],
  eyebrow: '面向严肃的 AI 软件工程', title: '让 AI 开发，\n沿着清晰的方向前进。',
  lead: '从目标到交付，SteerLine 用清晰的规划和任务依赖组织 AI 协作，让人始终掌握方向与关键决策。',
  primary: '了解 SteerLine', secondary: '学习 AI 开发', note: '开源项目 · 尚未发布',
  diagram: '一个清晰的工作流', steps: ['目标与规格', 'Roadmap', '任务与依赖', '执行与验证', '人的审查'],
  dnote: '目标由人定义，关键决策由人掌握。', intro: '从写代码，走向做工程。',
  introText: 'AI 能加速实现，但复杂项目还需要清晰的目标、可追踪的决策和可靠的验证。SteerLine 围绕这些基础组织工作。',
  principles: ['先明确方向', '让工作有序推进', '人始终在环'],
  descriptions: ['用规格和规划表达要解决的问题，让执行有清楚的依据。', '用 Roadmap 组织工作，用任务依赖表达先后关系。', '人负责产品目标、关键决策和审查，AI 参与执行。'],
  learnLabel: '两条学习路径', learnTitle: '从方法出发，\n到实践落地。',
  learnText: '无论你是探索 AI 开发，还是准备了解 SteerLine，都可以从这里开始。',
  cards: [['01 / AI 工程', '学习 AI 开发', '从 Spec、worktree 到 AI 的局限与人的角色，建立可持续的开发方法。', '探索教程'], ['02 / STEERLINE', '学习 SteerLine', '理解 Roadmap 和 DAG 如何帮助组织工作，再逐步了解产品的使用方式。', '探索教程']],
  status: '持续建设中', statusTitle: '工程，是一个持续改进的过程。', statusText: 'SteerLine 是一个尚未发布的开源项目。关注项目进展，了解目前的能力与边界。', github: '在 GitHub 查看项目', footer: '为认真构建软件的人而作。', about: '关于', lang: 'English',
} : {
  nav: ['Product', 'Learn AI Development', 'Learn SteerLine', 'Docs'],
  eyebrow: 'FOR SERIOUS AI SOFTWARE ENGINEERING', title: 'Give AI development\na clear direction.',
  lead: 'From intent to delivery, SteerLine brings structure to AI collaboration with clear plans and task dependencies, keeping people in control of the decisions that matter.',
  primary: 'Explore SteerLine', secondary: 'Learn AI Development', note: 'OPEN SOURCE · NOT YET RELEASED',
  diagram: 'A MORE INTENTIONAL WORKFLOW', steps: ['Goals & specs', 'Roadmap', 'Tasks & dependencies', 'Execute & verify', 'Human review'],
  dnote: 'People set the direction and own the key decisions.', intro: 'From writing code to building with intent.',
  introText: 'AI can accelerate implementation. Complex projects still need clear goals, traceable decisions, and reliable verification. SteerLine is built around those foundations.',
  principles: ['Start with direction', 'Make work flow', 'Keep people in control'],
  descriptions: ['Use specifications and plans to make the problem and the intended outcome explicit.', 'Organize work with a roadmap and make dependencies between tasks visible.', 'People own product goals, key decisions, and review while AI helps carry out the work.'],
  learnLabel: 'TWO PATHS TO EXPLORE', learnTitle: 'From better thinking\nto practical work.',
  learnText: 'Whether you are exploring AI development or getting to know SteerLine, start here.',
  cards: [['01 / AI ENGINEERING', 'Learn AI Development', 'Build lasting practices around specs, worktrees, AI limitations, and the role of people.', 'Explore the guides'], ['02 / STEERLINE', 'Learn SteerLine', 'Understand how roadmaps and DAGs organize work, then explore the product itself.', 'Explore the guides']],
  status: 'A WORK IN PROGRESS', statusTitle: 'Engineering is a practice of continuous improvement.', statusText: 'SteerLine is an open-source project that has not yet been released. Follow its progress and see its current scope.', github: 'View the project on GitHub', footer: 'For people who care about building software.', about: 'About', lang: '中文',
};
const links = [`/${lang}/product/`, `/${lang}/ai-engineering/`, `/${lang}/steerline/`, `/${lang}/docs/`, `/${lang}/updates/`];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'} class:list={[{ 'locale-zh': zh }]}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SteerLine — {zh ? '让 AI 开发沿着清晰的方向前进' : 'Give AI development a clear direction'}</title>
    <meta name="description" content={t.lead} />
    <link rel="alternate" hreflang="en" href="/en/" /><link rel="alternate" hreflang="zh-CN" href="/zh-cn/" />
  </head>
  <body>
    <header class="site-header"><SiteHeader lang={lang} /></header>
    <main>
      <section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="signal"></span>{t.eyebrow}</p><h1>{t.title}</h1><p class="lead">{t.lead}</p><div class="actions"><a class="button dark" href={links[0]}>{t.primary}<span>↗</span></a><a class="text-link" href={links[1]}>{t.secondary} <span>→</span></a></div><p class="release"><span></span>{t.note}</p></div>
        <div class="workflow" aria-label={t.diagram}><div class="workflow-head"><span>{t.diagram}</span><span>SL / 01</span></div><div class="flow-body"><div class="flow-line"></div>{t.steps.map((step, i) => <div class:list={['flow-row', { active: i === 1 }]}><span class="flow-index">0{i + 1}</span><span class="flow-node"></span><strong>{step}</strong><span class="flow-arrow">↗</span></div>)}</div><div class="workflow-foot"><span class="tiny-dot"></span>{t.dnote}</div><span class="corner corner-a"></span><span class="corner corner-b"></span></div>
      </section>
      <section class="principles section"><div class="wrap"><div class="section-heading"><p class="eyebrow">{zh ? '为什么选择结构化流程' : 'THE IDEA BEHIND STEERLINE'}</p><div><h2>{t.intro}</h2><p>{t.introText}</p></div></div><div class="principle-grid">{t.principles.map((p, i) => <article><span class="number">0{i + 1} /</span><h3>{p}</h3><p>{t.descriptions[i]}</p></article>)}</div></div></section>
      <section class="learning section wrap"><div class="learning-heading"><div><p class="eyebrow">{t.learnLabel}</p><h2>{t.learnTitle}</h2></div><p>{t.learnText}</p></div><div class="learn-grid">{t.cards.map((card, i) => <a class:list={['learn-card', { green: i === 1 }]} href={links[i + 1]}><span class="card-kicker">{card[0]}</span><span class="card-arrow">↗</span><div><h3>{card[1]}</h3><p>{card[2]}</p><span class="card-cta">{card[3]} <span>→</span></span></div></a>)}</div></section>
      <section class="status"><div class="wrap status-inner"><div><p class="eyebrow"><span class="signal"></span>{t.status}</p><h2>{t.statusTitle}</h2></div><div><p>{t.statusText}</p><a class="button light" href="https://github.com/erranliu/SteerLine">{t.github}<span>↗</span></a><a class="status-updates" href={links[4]}>{zh ? '查看项目更新' : 'Project updates'} →</a></div></div></section>
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
