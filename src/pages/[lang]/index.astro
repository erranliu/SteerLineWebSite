---
import '../../styles/home.css';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SeoHead from '../../components/SeoHead.astro';
import ChineseHome from '../../components/ChineseHome.astro';
export function getStaticPaths() { return ['en', 'zh-cn'].map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang === 'zh-cn' ? 'zh-cn' : 'en';
const zh = lang === 'zh-cn';
const t = (chinese: string, english: string) => zh ? chinese : english;
const product = `/${lang}/product/`;
const github = 'https://github.com/erranliu/SteerLine';
const title = t('SteerLine｜AI Workshop · 面向项目的 AI 开发系统', 'SteerLine | A Roadmap-Driven AI Development System');
const description = t('SteerLine 定义 AI Workshop：以多 Agent 编排与流程约束组织项目开发，让人聚焦产品方向、关键取舍与必要验收。开源，尚未发布。', 'SteerLine brings development methods and tools together around roadmaps, specifications, task dependencies, agent execution, and acceptance. Open source and not yet released.');
const problems = [
  [t('任务之间，怎样交接？', 'How does one task hand off to the next?'), t('前置接口是否稳定、后续任务能否开工，需要明确的成果和依赖关系。', 'Stable interfaces and explicit deliverables determine when dependent work can begin.')],
  [t('开发依据，怎样保持有效？', 'How do working agreements stay current?'), t('需求、设计和实现持续变化，执行者需要找到当前有效的规格与项目约定。', 'As requirements, design, and code evolve, each agent needs current specifications and project agreements.')],
  [t('交付结果，怎样证明？', 'What demonstrates delivery?'), t('编译成功、测试通过与需求完成回答不同问题，验收需要对应的版本和证据。', 'A successful build, a passing test, and a fulfilled requirement answer different questions. Acceptance needs versioned evidence.')],
];
const cycle = [t('产品目标', 'Product goals'), 'Roadmap', 'Spec / Plan', t('执行与测试', 'Build & test'), t('验收与交付', 'Accept & deliver')];
const designs = [
  { id: 'roadmap', title: t('Roadmap 驱动任务 DAG', 'Roadmaps drive the task DAG'), body: t('将阶段目标转为有明确成果和交接关系的任务。依赖决定开工条件，独立边界带来合理并行。', 'Turn milestones into tasks with clear outcomes and handoffs. Dependencies set start conditions; independent boundaries enable parallel work.') },
  { id: 'acceptance', title: t('测试与验收从规划开始', 'Plan verification from the start'), body: t('Spec 定义通过条件，Plan 安排验证，验收记录保留实际结果。让完成判断有据可查。', 'Specs define acceptance criteria, plans arrange verification, and acceptance records preserve results. Completion has evidence behind it.') },
  { id: 'documents', title: t('分层文档承载开发依据', 'Layered documents guide development'), body: t('通用规范、项目约定、任务文档与结果证据各有位置。开发方法通过 Agent 与工具落实到流程。', 'Shared standards, project agreements, task documents, and evidence each have a home. Agents and tools put these practices into the workflow.') },
  { id: 'collaboration', title: t('明确人与 Agent 的分工', 'Give people and agents clear roles'), body: t('目标工作方式中，用户掌握取舍与授权，SteerLine Agent 管理项目流程，执行 Agent 承担具体任务。', 'In the intended workflow, people own decisions and authorization, the SteerLine Agent manages the project process, and execution agents carry out tasks.') },
];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><SeoHead title={title} description={description} lang={lang} /></head>
  <body class:list={['home-page', { 'locale-zh': zh }]}>
    <a class="skip-link" href="#main">{t('跳转到主要内容', 'Skip to content')}</a>
    <header class="site-header"><SiteHeader lang={lang} /></header>
    <main id="main" data-pagefind-body>
      {zh ? <ChineseHome /> : <>
      <section class="hero wrap" aria-labelledby="home-title">
        <div>
          <p class="eyebrow"><span class="signal"></span>{t('Roadmap 驱动的 AI 开发系统', 'A ROADMAP-DRIVEN AI DEVELOPMENT SYSTEM')}</p>
          <h1 id="home-title" data-pagefind-meta="title">{t('让 AI 开发，\n持续推进整个项目。', 'Keep AI development\nmoving the whole\nproject forward.')}</h1>
          <p class="lead">{t('SteerLine 同时提供开发方法与配套工具，将项目规划、规格文档、任务依赖、开发执行与测试验收组织成持续推进的开发流程。', 'SteerLine brings development methods and tools together, connecting project planning, specifications, task dependencies, execution, and acceptance into an ongoing development process.')}</p>
          <div class="actions"><a class="button dark" href={`${product}#workflow`}>{t('了解开发流程', 'Explore the workflow')} <span aria-hidden="true">↗</span></a><a class="text-link" href={github}>{t('查看开源项目', 'View on GitHub')} <span aria-hidden="true">↗</span></a></div>
          <p class="release"><span class="signal"></span>{t('开源 · 尚未发布', 'OPEN SOURCE · NOT YET RELEASED')}</p>
        </div>
        <aside class="project-map" aria-label={t('项目依赖与开发闭环示意', 'Illustration of project dependencies and feedback')}>
          <div class="map-caption"><span>SL / PROJECT FLOW</span><span>{t('产品方向示意', 'INTENDED WORKFLOW')}</span></div>
          <div class="map-goal"><span class="map-label">ROADMAP / 01</span><strong>{t('交付一个新功能', 'Deliver a new feature')}</strong><p>{t('明确成果、范围与通过条件', 'Agree on outcomes, scope, and acceptance')}</p></div>
          <div class="map-connector" aria-hidden="true">↓</div>
          <div class="map-parallel"><div class="map-task"><span class="map-label">TASK A</span><strong>{t('公共接口', 'Shared interface')}</strong><span class="map-detail">Spec · Plan · PR</span></div><div class="map-task"><span class="map-label">TASK B</span><strong>{t('独立测试准备', 'Independent test setup')}</strong><span class="map-detail">Spec · Plan · PR</span></div></div>
          <p class="map-dependency">↳ {t('使用接口的任务，等待前置交付', 'Consumers wait for the interface to be delivered')}</p>
          <div class="map-delivery"><span aria-hidden="true">✓</span><div><strong>{t('核验结果，推进后续任务', 'Verify delivery. Unblock dependent work.')}</strong><span class="map-detail">{t('验收结果 · 交付证据', 'Acceptance results · Delivery evidence')}</span></div></div>
          <div class="map-return"><span aria-hidden="true">↶</span>{t('交付结果回到 Roadmap，继续规划', 'Bring delivery results back into roadmap planning')}</div>
        </aside>
      </section>
      <section class="section problems" aria-labelledby="problems-title"><div class="wrap">
        <div class="section-heading"><p class="eyebrow">01 / {t('持续开发中的问题', 'THE PROJECT BETWEEN TASKS')}</p><div><h2 id="problems-title">{t('让每轮开发，\n都能接得上下一轮。', 'Make each round of development\nconnect to the next.')}</h2><p>{t('多 Agent 编排提供并行执行的基础。SteerLine 进一步关注项目如何被规划、约束、验证，以及如何根据交付结果继续演进。', 'Multi-agent orchestration provides a foundation for parallel execution. SteerLine also addresses how a project is planned, constrained, verified, and advanced by its delivery results.')}</p></div></div>
        <div class="problem-grid">{problems.map(([heading, body], i) => <article><span class="number">0{i + 1}</span><h3>{heading}</h3><p>{body}</p></article>)}</div>
      </div></section>
      <section class="section wrap" aria-labelledby="cycle-title">
        <div class="section-heading"><p class="eyebrow">02 / {t('目标开发闭环', 'THE INTENDED DEVELOPMENT LOOP')}</p><div><h2 id="cycle-title">{t('规划有依据，\n交付有回路。', 'Plan with context.\nFeed delivery back into the plan.')}</h2><p>{t('将目标拆成可交付成果，为执行明确依据与验证方式。实际交付再回到 Roadmap，支持下一轮安排。', 'Break goals into deliverables, define the basis for execution and verification, then use actual delivery to inform the next round of roadmap planning.')}</p></div></div>
        <ol class="cycle-list">{cycle.map((step, i) => <li><span class="number">0{i + 1}</span><strong>{step}</strong>{i < cycle.length - 1 && <span class="cycle-arrow" aria-hidden="true">→</span>}</li>)}</ol>
        <div class="cycle-return"><span aria-hidden="true">↶</span>{t('同步结果与待决策事项，继续维护 Roadmap', 'Bring results and open decisions back into the roadmap')}</div>
        <a class="text-link section-link" href={`${product}#workflow`}>{t('用一个功能案例看完整流程', 'Follow one feature through the workflow')} <span aria-hidden="true">→</span></a>
      </section>
      <section class="section design-section" aria-labelledby="design-title"><div class="wrap">
        <div class="section-heading"><p class="eyebrow">03 / {t('开发方法与配套工具', 'METHODS AND TOOLS TOGETHER')}</p><div><h2 id="design-title">{t('把开发方法，\n落实到项目流程。', 'Put development practices\ninto the project workflow.')}</h2><p>{t('SteerLine 的设计覆盖规划、文档、实现与验收，让多个执行者在多轮开发中使用明确的任务依据和交付要求。', 'SteerLine connects planning, documentation, implementation, and acceptance, giving multiple agents clear task agreements and delivery requirements across rounds of development.')}</p></div></div>
        <div class="design-grid">{designs.map((item, i) => <a href={`${product}#${item.id}`} class="design-card"><span class="number">0{i + 1} /</span><h3>{item.title}</h3><p>{item.body}</p><span class="card-link">{t('了解设计', 'Explore the design')} <span aria-hidden="true">↗</span></span></a>)}</div>
      </div></section>
      <section class="section progress-section" aria-labelledby="progress-title"><div class="wrap">
        <div class="section-heading"><p class="eyebrow">04 / {t('当前进展', 'WHERE THE PROJECT STANDS')}</p><div><h2 id="progress-title">{t('已有基础，\n也有明确的下一步。', 'A working foundation.\nA clear direction ahead.')}</h2><p>{t('当前已具备任务 DAG、依赖检查、执行反馈与真实 PR 合并核验，并已接入 Roadmap 转正的解析、文档生成和正式入图流程。Web 通过 SteerRunner 连接执行路径，各项已验范围以仓库记录为准。', 'The current foundation includes a task DAG, dependency checks, execution feedback, and PR merge verification, plus roadmap promotion through parsing, document generation, and task admission. The Web interface connects execution paths through SteerRunner; acceptance records define the verified scope.')}</p><p class="direction-note">{t('后续方向：面向用户的 SteerLine 主 Agent、完整项目周期管理，以及授权范围内的有限自主推进。', 'Next: a user-facing SteerLine lead agent, project lifecycle management, and limited autonomous progress within agreed authorization.')}</p><div class="actions"><a class="button light" href={`${product}#current-stage`}>{t('查看能力与边界', 'Capabilities and boundaries')} <span aria-hidden="true">↗</span></a><a class="text-link" href={`/${lang}/updates/`}>{t('项目更新', 'Project updates')} <span aria-hidden="true">→</span></a></div></div></div>
      </div></section>
      <section class="section wrap" aria-labelledby="learning-title">
        <div class="section-heading"><p class="eyebrow">05 / {t('继续探索', 'CONTINUE EXPLORING')}</p><div><h2 id="learning-title">{t('理解方法，\n再走进实践。', 'Understand the methods.\nExplore the practice.')}</h2><p>{t('从通用的 AI 软件工程方法出发，进一步理解 SteerLine 的理念与工作方式。', 'Start with general AI software engineering methods, then explore the ideas and workflow behind SteerLine.')}</p></div></div>
        <div class="learn-grid"><a class="learn-card" href={`/${lang}/ai-engineering/`}><span class="number">AI DEVELOPMENT</span><h3>{t('学习 AI 开发', 'Learn AI development')}</h3><p>{t('从 Spec、Git Worktree 到 AI 的边界，建立自己的开发方法。', 'Build your practice around specs, Git worktrees, and an understanding of AI limitations.')}</p><span class="card-link">{t('阅读教程', 'Read the guides')} <span aria-hidden="true">↗</span></span></a><a class="learn-card" href={`/${lang}/steerline/`}><span class="number">LEARN STEERLINE</span><h3>{t('学习 SteerLine', 'Learn SteerLine')}</h3><p>{t('理解 Roadmap、任务依赖，以及它们如何承载项目推进。', 'Understand roadmaps, task dependencies, and how they support project progress.')}</p><span class="card-link">{t('了解核心理念', 'Explore the concepts')} <span aria-hidden="true">↗</span></span></a></div>
      </section>
      </>}
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>
